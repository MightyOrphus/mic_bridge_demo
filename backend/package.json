{
  "name": "backend",
  "version": "0.0.1",
  "description": "Dynamics NAV BFF Backend",
  "engines": {
    "node": ">=22.0.0"
  },
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "cross-env NODE_OPTIONS=--openssl-legacy-provider nest start",
    "start:dev": "cross-env NODE_OPTIONS=--openssl-legacy-provider nest start --watch",
    "start:prod": "cross-env NODE_OPTIONS=--openssl-legacy-provider node dist/main",
    "test": "cross-env NODE_OPTIONS=--openssl-legacy-provider jest"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/cache-manager": "^3.1.3",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "axios": "^1.7.9",
    "cache-manager": "^6.4.0",
    "cross-env": "^7.0.3",
    "ntlm-client": "^0.1.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.23",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.27",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.19.21",
    "@types/ntlm-client": "^0.1.3",
    "@types/supertest": "^6.0.3",
    "@types/xml2js": "^0.4.14",
    "jest": "^29.7.0",
    "jest-util": "^30.4.1",
    "prettier": "^3.8.4",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.6.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
